# Vite inlines VITE_* when `bun run build` runs (mode production). Copy this file to the
# environment that build reads. The repository root `.env` holds deploy secrets and is not
# read by Vite. The giye.org deployment sets them in deploy/site.env, which deploy/push.sh reads.
VITE_GIYE_ORIGIN=https://example.org
VITE_GIYE_CONTACT_EMAIL=contact@example.org

