__pycache__/
*.pyc
.venv/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
# never commit real archive data (the top-level data/ tree). Packaged vocabulary
# under src/giye/normalize/data/ is not archive data and stays in the tree.
/data/
!examples/demo/**
# `giye collect` writes this, and the negation above would otherwise re-include it.
examples/demo/data/
examples/demo/**/__pycache__/
web/node_modules/
web/.output/
web/.tanstack/
web/.wrangler/
web/.nitro/
web/.vinxi/

# Private operation of the reference instance (giye.org). These paths live in this working copy but are
# versioned only by the private repository (.git-private, see AGENTS.md); they hold personal data or
# code not yet ported to the package. Never force-add them here.
/.git-private/
/gitp
/data/
/research/
/ref/
/giye_paper/
/archive/
/scripts/
/anno.sh
/tools/annotate/
/tools/regress*
/tools/__pycache__/
.env
